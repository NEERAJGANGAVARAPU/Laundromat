# Email Configuration for Real Delivery
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=your_gmail_address@gmail.com
EMAIL_HOST_PASSWORD=your_16_digit_app_password
DEFAULT_FROM_EMAIL=Spinzone Laundromat <your_gmail_address@gmail.com>

# Owner Admin Default Credentials (loaded securely by backend)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_default_password
